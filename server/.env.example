# twine-story-store — copy to .env next to the binary (or point at it with --env).
#
# Values in the real environment win over this file, so a systemd unit's Environment=
# is never silently overruled by a stale .env in the working directory.

# REQUIRED. One shared token for everyone who uses the editor. At least 16 characters,
# or the server refuses to start. Generate one with:  openssl rand -hex 24
AUTH_TOKEN=

# Where to listen. Loopback by default: Caddy terminates TLS in front of it.
ADDR=127.0.0.1:8080

# Where the stories live. Back this up; it is the whole of the state.
DATA_DIR=./data

# Editor origins allowed to call the API. Comma separated; * allows any.
CORS_ORIGINS=https://twine-ig.tmpx.space,http://127.0.0.1:5173

# Body limits, in bytes. Both are reported by /ping so the editor can complain before
# uploading rather than after. Keep Caddy's request_body max_size above MAX_ASSET_BYTES.
MAX_ASSET_BYTES=67108864
MAX_STORY_BYTES=33554432

# How many story snapshots to keep per story. Twenty snapshots of a 200 KB story is
# about 400 KB gzipped, so this can be raised without anyone noticing.
REV_KEEP=20

# How long an asset blob may sit unnamed by the manifest before the janitor sweeps it.
# Not shorter than the slowest plausible checkout: blobs are uploaded before the
# manifest that names them.
ORPHAN_TTL=168h

# How long a deleted story's tombstone and history survive.
TOMBSTONE_TTL=2160h
