*.swp
node_modules/*
dist/*
*.DS_Store
.idea
electron-build/*
coverage/*
docs/en/book/*
/test-results/
/playwright-report/
/playwright/.cache/

# Nested package caches (the render-dom harness runs its own vite).
**/node_modules/
**/.vite/

# Safety net for credential files. The real deploy token lives outside the repo
# in ~/.config/cloudflare.env; this just stops a stray copy from
# being committed. The tracked .env (build vars only) is unaffected -- git does
# not apply ignore rules to files already in the index.
*.env
