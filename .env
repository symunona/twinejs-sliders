REACT_APP_VERSION=$npm_package_version
REACT_APP_NAME=$npm_package_name

# Where `npm run deploy-cloudflare` publishes. The Pages project is the first DNS
# label of this hostname (twine-ig.tmpx.space -> project "twine-ig"). Override for
# one box in .env.local, or for one run: DEPLOY_TARGET=... npm run deploy-cloudflare
DEPLOY_TARGET=twine-ig.tmpx.space
